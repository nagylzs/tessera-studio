// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = Tessera Studio

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = eu.nagylzs.tessera-studio

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 László Zsolt Nagy. MIT licence.

// Signed to run locally, so CI builds without certificates. An App Store
// archive passes TESSERA_CODE_SIGN_IDENTITY="Apple Development" on the
// command line: only this target reads it, while CODE_SIGN_IDENTITY there
// would also sign the Swift packages' resource bundles, which the export
// leaves with a development signature (ITMS-90284).
TESSERA_CODE_SIGN_IDENTITY = -
CODE_SIGN_IDENTITY = $(TESSERA_CODE_SIGN_IDENTITY)
